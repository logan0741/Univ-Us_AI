# ============================================================
# Univ-Us_AI 환경변수 예시
#
#   cp .env.example .env
#
#   .env 는 절대 커밋하지 않습니다 (.gitignore 로 막아둠).
#   실수로 커밋했다면 즉시 팀에 알리고 키를 재발급받으세요.
#   커밋을 되돌려도 git 기록에는 남습니다.
# ============================================================

# ── 모델 슬롯 ───────────────────────────────────────────────
# 코드에는 모델 이름을 직접 쓰지 않고 아래 슬롯을 통해 씁니다.
# 실제 어떤 모델을 넣을지는 eval_ai-agent 비교 실험으로 정합니다.
# 확정 전까지는 각자 발급받은 키로 채워서 실험합니다.

# 판단·생성·구조화 추출용 주 LLM (JSON 출력 + Function Calling 필요)
LLM_MAIN_BASE_URL=
LLM_MAIN_API_KEY=
LLM_MAIN_MODEL=

# 청크 벡터화용 임베딩 (rag_ai-agent, notice_ai-agent)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 문서 레이아웃·표 인식 (doc_ai-agent, pic_ai-agent)
DOC_PARSER_BASE_URL=
DOC_PARSER_API_KEY=

# 이미지 이해 — DOC_PARSER 로 충분하면 비워둡니다 (pic_ai-agent)
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# ── 데이터베이스 ────────────────────────────────────────────
# 로컬 개발용. pgvector 확장이 설치된 PostgreSQL 이 필요합니다.
DATABASE_URL=postgresql+psycopg://univus:univus@localhost:5432/univus

# ── 실행 설정 ───────────────────────────────────────────────
LOG_LEVEL=INFO

# 아침 브리핑 실행 시각 (brief_ai-agent)
BRIEFING_HOUR=7
BRIEFING_MINUTE=30

# 개발 중 토큰 낭비를 막는 캐시 (계획서 4.3 라 비용 관리)
ENABLE_RESPONSE_CACHE=true
CACHE_DIR=.cache

# ── JNU 학사 데이터 수집 (src/collect) ──────────────────────
# 본인 계정으로 로그인한 세션을 재사용합니다.
# ⚠️ ID/비밀번호는 여기에 넣지 않습니다. `python -m src.collect.cli login` 으로
#    브라우저에서 직접 로그인하고 세션(쿠키)만 저장합니다.
JNU_SUGANG_COURSES_URL=https://sugang.jnu.ac.kr/Pages/Suup080
JNU_TIMETABLE_URL=https://hakstd.jnu.ac.kr/web/Suup/Suup090
JNU_SYLLABUS_URL=https://hakstd.jnu.ac.kr/web/Suup/Suup051
JNU_ECLASS_URL=https://sel.jnu.ac.kr/

# eClass(Moodle) 캘린더 .ics 내보내기 URL — 본인 계정에서 발급 (사용법 문서 참고).
# 비우면 eclass 는 대시보드 HTML 만 저장합니다.
JNU_ECLASS_ICS_URL=

# 요청 간격(초) — 학교 서버 부하 최소화 (수집 계획서 §6)
JNU_COLLECT_MIN_INTERVAL_SEC=3

# StdAuth 재학인증(선택) — 학교에서 apikey 발급 필요. 대량 수집 아님(1인 확인용)
JNU_STDAUTH_BASE_URL=https://jnuapi.jnu.ac.kr
JNU_STDAUTH_APIKEY=

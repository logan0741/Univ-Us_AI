# ============================================================
# Univ-Us_AI .gitignore
#
# 여기 걸린 파일은 git 에 올라가지 않습니다.
# 특히 아래 두 가지는 절대 올리면 안 됩니다.
#   1. API 키 / 인증 정보
#   2. 팀원 개인 데이터 (강의계획서, 이수내역, 메일)
# ============================================================

# ── 1. 비밀 정보 ────────────────────────────────────────────
.env
.env.*
!.env.example

# Google OAuth (Calendar / Gmail 연동)
credentials.json
token.json
client_secret*.json
service-account*.json

*.pem
*.key
*.p12
secrets/

# ── 2. 개인 데이터 ──────────────────────────────────────────
# 팀원 본인의 강의계획서·이수내역·메일이 들어가는 곳입니다.
# 계획서 4.2 원칙에 따라 저장소 밖으로 나가지 않게 합니다.
#
# 'data/' 가 아니라 'data/*' 인 이유:
# git 은 제외된 '디렉터리' 안의 파일을 ! 로 다시 포함시키지 못합니다.
# 안내 문서만 올리려면 반드시 data/* 형태로 써야 합니다.
data/*
!data/.gitkeep
!data/README.md

# 라벨링된 테스트셋도 원문이 개인 문서라 기본 제외합니다.
# 공유가 필요하면 개인정보를 지운 뒤 팀과 합의해 예외를 추가하세요.
datasets/
samples/

# 기획·계획 문서 (팀원 이름 등 개인정보 포함)
# 저장소 대신 팀 채널로 공유합니다.
*.pdf
*.hwp
*.hwpx
*.docx
*.pptx
*.xlsx

# ── 3. 모델 가중치 / 캐시 ───────────────────────────────────
models/
checkpoints/
*.safetensors
*.gguf
*.bin
*.pt
*.pth
*.onnx

.cache/
.huggingface/
hf_cache/

# ── 4. 벡터 인덱스 / 로컬 DB ────────────────────────────────
chroma/
.chroma/
faiss_index/
*.index
*.sqlite3
*.db
!alembic/**/*.py

# ── 5. 실행 산출물 ──────────────────────────────────────────
outputs/
results/
runs/
logs/
*.log

# ── 6. Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ── 7. 가상환경 ─────────────────────────────────────────────
.venv/
venv/
env/
ENV/
conda-meta/

# ── 8. 테스트 / 정적 분석 ───────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ── 9. 노트북 ───────────────────────────────────────────────
.ipynb_checkpoints/
*-checkpoint.ipynb

# ── 10. 에디터 / OS ─────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── 11. 기타 ────────────────────────────────────────────────
*.tmp
*.bak
node_modules/

# 주의: 루트의 프로젝트 계획서 PDF 는 저장소에 포함되어야 하므로
#       *.pdf 를 전역으로 무시하지 않습니다.
#       문서 무시는 위 data/ 경로 기준으로만 겁니다.
